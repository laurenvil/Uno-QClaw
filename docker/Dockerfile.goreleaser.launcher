FROM alpine:3.21

ARG TARGETPLATFORM

RUN apk add --no-cache ca-certificates tzdata

COPY $TARGETPLATFORM/qclaw /usr/local/bin/qclaw
COPY $TARGETPLATFORM/qclaw-launcher /usr/local/bin/qclaw-launcher
COPY $TARGETPLATFORM/qclaw-launcher-tui /usr/local/bin/qclaw-launcher-tui

ENTRYPOINT ["qclaw-launcher"]
CMD ["-public", "-no-browser"]
